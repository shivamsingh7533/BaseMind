{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "stitch": {
      "type": "remote",
      "url": "https://stitch.googleapis.com/mcp",
      "enabled": true,
      "headers": {
        "X-Goog-Api-Key": "{env:STITCH_API_KEY}"
      }
    },
    "agentmemory": {
      "type": "local",
      "command": ["npx", "-y", "@agentmemory/mcp"],
      "enabled": true
    },
    "basemind": {
      "type": "local",
      "command": ["backend/.venv/Scripts/python.exe", "mcp/basemind_mcp.py"],
      "enabled": true,
      "environment": {
        "BASE_MIND_TOKEN": "{env:BASE_MIND_TOKEN}",
        "BASE_MIND_API_URL": "{env:PROD_APP_URL}"
      }
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest", "--isolated"],
      "enabled": true
    }
  }
}
